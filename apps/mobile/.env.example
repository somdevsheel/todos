# Expo only exposes env vars prefixed EXPO_PUBLIC_ to client code — see
# lib/api-client.ts. Left unset, the app defaults to 10.0.2.2 (the Android
# emulator's alias for the host machine's localhost). A physical device on
# the same network needs your host machine's real LAN IP instead, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000/api/v1
EXPO_PUBLIC_API_URL=
