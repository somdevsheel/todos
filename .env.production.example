# ==============================================================================
# Arutech Workspace — PRODUCTION environment variables.
#
# Copy to `.env.production` at the repo root (used by
# docker/docker-compose.prod.yml — see that file's header comment). Never
# commit the real `.env.production`; it's covered by the same `.env.*`
# .gitignore/.dockerignore pattern as every other real env file in this
# repo.
#
# This is NOT the same file as .env.example — that one is tuned for local
# development (MailHog, a permissive dev JWT secret, localhost CORS) and
# must never be copied verbatim into production. Every value below is a
# production-shaped placeholder, not a working default.
# ==============================================================================

# ---- App -------------------------------------------------------------------
NODE_ENV=production
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=https://workspace.arutechconsultancy.com

# ---- Postgres (read directly by the postgres container — see
# docker-compose.prod.yml's env_file comment) --------------------------------
POSTGRES_USER=arutech
POSTGRES_PASSWORD=REPLACE_ME_generate_a_real_random_password
POSTGRES_DB=arutech_workspace

# ---- Database ----------------------------------------------------------------
# Host is "postgres" — the compose service name, resolved over the
# compose-internal Docker network, not localhost. User/password/dbname
# MUST match the POSTGRES_* values immediately above — nothing keeps them
# in sync automatically.
DATABASE_URL=postgresql://arutech:REPLACE_ME_generate_a_real_random_password@postgres:5432/arutech_workspace?schema=public

# ---- Redis -------------------------------------------------------------------
# Host is "redis" — the compose service name, same reasoning as DATABASE_URL.
REDIS_URL=redis://redis:6379

# ---- JWT -----------------------------------------------------------------
# Generate strong random secrets: openssl rand -base64 48
# env.schema.ts refuses to boot in production with a secret under 32 chars.
JWT_ACCESS_SECRET=REPLACE_ME_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=REPLACE_ME_a_DIFFERENT_openssl_rand_base64_48
JWT_REFRESH_TTL=30d

# ---- Company email restriction -----------------------------------------------
ALLOWED_EMAIL_DOMAINS=arutechconsultancy.com

# ---- CORS --------------------------------------------------------------------
# env.schema.ts refuses to boot in production if this contains "localhost".
CORS_ORIGINS=https://workspace.arutechconsultancy.com

# ---- Mail (invitations / password reset) --------------------------------------
# A real provider — env.schema.ts refuses "localhost"/"mailhog" here in
# production. See README.md's own real Gmail-SMTP example for the shape
# (smtp.gmail.com:587, an account app password, not MailHog).
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM_NAME=Arutech Workspace
SMTP_FROM_EMAIL=REPLACE_ME

# ---- Rate limiting -------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5

# ---- File storage --------------------------------------------------------------
# "local" is the shipped Phase 8 default — see DEPLOYMENT.md for why
# (single-replica deployment, a persistent volume already does the job).
# Switch to "s3" and fill in the four STORAGE_* vars below only if/when a
# real S3-compatible bucket is provisioned.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ==============================================================================
# Firebase Cloud Messaging — required in production (env.schema.ts fails
# startup loudly if any are missing outside development). See FCM.md for
# how to provision a real Firebase project.
# ==============================================================================
FCM_PROJECT_ID=REPLACE_ME
FCM_CLIENT_EMAIL=REPLACE_ME
FCM_PRIVATE_KEY=REPLACE_ME

# ==============================================================================
# Only needed if STORAGE_PROVIDER=s3 above (see files/storage/s3.storage.ts).
# STORAGE_REGION must match the bucket's real region if this is real AWS
# S3 (not just an S3-compatible server) — see s3.storage.ts's docstring.
# ==============================================================================
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
