# ==============================================================================
# Arutech Workspace — environment variables
#
# Copy this file to `.env` in the repo root (used by docker-compose.dev.yml)
# AND to `apps/api/.env` (used by the NestJS app directly when run outside
# Docker, e.g. `pnpm dev:api`). Never commit a real `.env` file.
#
# Vars marked "Phase N — reserved" are validated as optional in development
# and are not yet consumed by any running code. They exist now so later
# phases don't require reshaping the config module.
# ==============================================================================

# ---- App -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:3000

# ---- Database ----------------------------------------------------------------
# Local dev matches docker/docker-compose.dev.yml (project: arutech-workspace)
DATABASE_URL=postgresql://arutech:arutech_dev_password@localhost:55432/arutech_workspace?schema=public

# ---- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:63790

# ---- JWT -----------------------------------------------------------------
# Generate strong random secrets for real environments, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32chars-min
JWT_REFRESH_TTL=30d

# ---- Company email restriction -----------------------------------------------
# Comma-separated list. Centralized here — never hardcode a domain elsewhere.
ALLOWED_EMAIL_DOMAINS=arutechconsultancy.com

# ---- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins (only the Next.js origin —
# browsers never call the API directly, see AUTHENTICATION.md).
CORS_ORIGINS=http://localhost:3000

# ---- Mail (invitations / password reset) --------------------------------------
# Local dev: point at the MailHog service started by docker-compose.dev.yml.
SMTP_HOST=localhost
SMTP_PORT=10250
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Arutech Workspace
SMTP_FROM_EMAIL=no-reply@arutechconsultancy.com


# ---- Frontend (Next.js) -------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Arutech Workspace
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1

# ---- Rate limiting -------------------------------------------------------------
# AUTH_THROTTLE_LIMIT is deliberately strict (5/min/IP on login/accept-invitation/
# password-reset) — `pnpm test:e2e` overrides it to a much higher value for its
# own process only (see apps/api/package.json's "test:e2e" script), so this real
# value is never weakened just to make automated tests convenient.
THROTTLE_TTL=60
THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5

# ---- File storage (task/chat/event attachments) --------------------------------
# "local" writes under STORAGE_LOCAL_DIR on the API container/host's own disk —
# fine for one instance, not for a multi-instance production deployment (see
# DEPLOYMENT.md). "s3" is reserved for a later swap-in via the STORAGE_ENDPOINT/
# STORAGE_BUCKET/STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY vars below.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ==============================================================================
# Firebase Cloud Messaging — consumed by FcmService (apps/api/src/fcm/).
# Leave blank in dev: no Firebase project exists yet (see FCM.md), and
# FcmService degrades to a logged no-op rather than crashing. Required in
# production — env.schema.ts fails startup loudly if any of the three are
# missing outside development.
# ==============================================================================
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ==============================================================================
# Consumed by S3StorageProvider (apps/api/src/files/storage/s3.storage.ts)
# when STORAGE_PROVIDER=s3 above — works against real AWS S3 or any
# S3-compatible endpoint (MinIO, DigitalOcean Spaces, etc). Leave blank
# with STORAGE_PROVIDER=local (the default, and what's actually shipped in
# docker-compose.prod.yml — see DEPLOYMENT.md for why). The first four are
# required, in every environment, the moment STORAGE_PROVIDER=s3 is set —
# env.schema.ts fails startup loudly rather than failing on the first
# upload. STORAGE_REGION is the exception: optional (most S3-compatible
# servers ignore it), but if this is REAL AWS S3, it must match the
# bucket's actual region or every request fails authentication — S3Client
# uses region in request signing, unlike most self-hosted alternatives.
# ==============================================================================
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
